---
import '../styles/global.css';
import '../styles/skins.css';
import { createHash } from 'node:crypto';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import AuthNavLink from '../components/auth/AuthNavLink';
import SiteFooter from '../components/SiteFooter.astro';
import SkinPicker from '../components/SkinPicker.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ToolsMenu from '../components/ToolsMenu.astro';
import ToolsSidebar from '../components/ToolsSidebar.astro';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { directionOf, getMessages, isTranslated, locales } from '../i18n';
import { plansStartAt } from '../lib/pricing';
import { graph, organization, siteName, website } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Path of this page without the locale prefix, e.g. "merge-pdf". Empty for the home page. */
  path: string;
  /** Share image under /og/, without extension; defaults to the site-wide one. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Extra schema.org items for this page; Organization and WebSite are always included. */
  jsonLd?: Record<string, unknown>[];
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /**
   * Show the persistent, categorized tools sidebar (src/components/ToolsSidebar.astro)
   * beside the content. Opt-in rather than site-wide: a content page's job is to inform
   * on one thing, and a 43-tool rail fighting for attention works against that — tool
   * pages, the category hubs and the home page are where it earns its place. On by
   * default (its handles stay on the window edge when it is hidden, and bring it back); see
   * `toolsSidebarDefaultHidden` for a page that wants it opt-in-to-open instead.
   */
  toolsSidebar?: boolean;
  /** Start the sidebar hidden on this page even on desktop, where it otherwise defaults
   * to visible — the home page wants it reachable but not competing with its own hero
   * and category sections on a first visit. No effect without `toolsSidebar`, and no
   * effect once a visitor has made their own explicit choice (stored in localStorage). */
  toolsSidebarDefaultHidden?: boolean;
  /**
   * Run the member-view script before first paint (home and pricing). It reads the plan from the
   * signed-in hint cookie and the start date, and sets data-plan / data-started on <html>, so a member
   * never sees the new-visitor page for a moment. Off elsewhere: a tool page has nothing to switch, and
   * the script is bytes in every page's HTML, which the performance budgets count.
   */
  memberHint?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = 'default',
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  toolsSidebar = false,
  toolsSidebarDefaultHidden = false,
  memberHint = false,
} = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const t = getMessages(locale).common;
// A locale with no translation serves English under its own URL. Indexing that would publish
// thin duplicates of every page, so it is noindex until the locale has a catalogue.
const keepOut = noindex || !isTranslated(locale);
const site = Astro.site!;
const canonical = getAbsoluteLocaleUrl(locale, path);
const image = new URL(`/og/${ogImage}.png`, site).href;
const structuredData = graph([organization(site), website(site, locale), ...jsonLd]);

// `is:inline` opts these two scripts out of Astro's own bundling pipeline — which is
// also how Astro discovers inline scripts to hash for its CSP meta tag, so it never
// sees these and the browser blocks them as unlisted inline scripts. Astro.csp exposes
// an API for exactly this case: compute the script's own hash from the same string
// that's rendered (via set:html below, so the two can never drift) and register it.
function cspInlineScript(source: string): string {
  // A bare hash, not { kind: 'element' } — that scopes into its own script-src-elem
  // directive instead of extending script-src, and script-src-elem doesn't inherit
  // 'self'/'wasm-unsafe-eval' from script-src: every other script on the page (every
  // React island's module chunk) got silently blocked until this was a bare string.
  Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(source).digest('base64')}`);
  return source;
}

const memberHintScript = memberHint
  ? cspInlineScript(`(function(){try{var d=document.documentElement,m=document.cookie.match(/(?:^|; )leaflock_signed_in=([a-z]+)/);if(m&&m[1]!=='free')d.dataset.plan=m[1];if(Date.now()>=${plansStartAt})d.dataset.started='1'}catch(e){}})()`)
  : '';

const preTheme = cspInlineScript(`
      // Apply a saved light/dark choice before first paint, so the page doesn't flash.
      // The default is always Light, never the device setting: a visitor with nothing
      // saved gets data-theme set to light here, the same as if they had chosen it.
      // Only a saved 'dark' (the single button in ThemeToggle.astro) gives dark. Anything
      // else, including an older saved 'system', reads as light.
      try {
        const theme = localStorage.getItem('theme');
        document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
        // Same reasoning, for the tools sidebar: apply a saved hidden choice and dock
        // edge before first paint so a returning visitor doesn't see it flash open, or
        // on the wrong edge, before settling. With nothing saved, a narrow viewport
        // still needs a pre-paint default: a first mobile visit should not flash a
        // full-screen overlay it never asked for — and so does a page that opted into
        // starting hidden regardless of width (the home page) — matching
        // ToolsSidebar.astro's own un-saved-choice defaults.
        // On a narrow viewport the sidebar is a full-screen drawer, so it always starts
        // closed whatever was saved: a saved "visible" would reopen it over the content on
        // every page the visitor navigates to.
        const sidebarVisible = localStorage.getItem('toolsSidebarVisible');
        if (window.matchMedia('(max-width: 48rem)').matches) {
          document.documentElement.dataset.sidebarState = 'hidden';
        } else if (sidebarVisible === 'hidden' || sidebarVisible === 'visible') {
          document.documentElement.dataset.sidebarState = sidebarVisible;
        } else if (document.documentElement.dataset.sidebarDefaultHidden === 'true') {
          document.documentElement.dataset.sidebarState = 'hidden';
        }
        // No dock-specific CSS exists for the attribute being absent, so a first-ever
        // visit (nothing stored yet) still needs an explicit default here, not just a
        // fallback in ToolsSidebar.astro's own script — otherwise the sidebar briefly
        // has no width or height at all, before that script runs.
        const sidebarDock = localStorage.getItem('toolsSidebarDock');
        document.documentElement.dataset.sidebarDock = sidebarDock === 'left' || sidebarDock === 'right' ? sidebarDock : 'left';
        // Same reasoning, for the chosen skin (src/components/SkinPicker.astro): a
        // cookie, not localStorage, so it's readable the same way whether or not the
        // visitor is signed in, and matches the site's existing leaflock_* cookie
        // convention (src/lib/server/session.ts). No cookie means the default skin —
        // already the :root tokens in global.css — so there's nothing to apply in that
        // case.
        const skinMatch = document.cookie.match(/(?:^|; )leaflock_skin=([^;]+)/);
        if (skinMatch) document.documentElement.dataset.skin = decodeURIComponent(skinMatch[1]);
      } catch {}
    `);

const chromeHeightScript = cspInlineScript(`
          (function () {
            var header = document.querySelector('.site-header');
            var strip = document.querySelector('.privacy-strip');
            var h = (header ? header.offsetHeight : 0) + (strip ? strip.offsetHeight : 0);
            document.documentElement.style.setProperty('--tools-chrome-h', h + 'px');
          })();
        `);
---

<!doctype html>
<html lang={locale} dir={directionOf(locale)} data-sidebar-default-hidden={toolsSidebarDefaultHidden}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keepOut && <meta name="robots" content="noindex" />}
    {!keepOut && <link rel="canonical" href={canonical} />}
    {
      !keepOut &&
        Object.keys(locales).map((code) => <link rel="alternate" hreflang={code} href={getAbsoluteLocaleUrl(code, path)} />)
    }
    {!keepOut && <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', path)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" id="siteFavicon" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#e5533d" id="siteThemeColor" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={structuredData} />
    <script is:inline set:html={preTheme} />
    {memberHint && <script is:inline set:html={memberHintScript} />}
    <script>
      // The favicon and the mobile theme-color meta both ship a static default (the
      // link/meta tags above) so there's something correct before this runs — then this
      // repaints both from whichever skin and light/dark mode are actually active. Same
      // leaf-and-lock shape as the header brand mark (below, in <body>): one more place
      // that would silently go stale if a colour were hard-coded instead of read from
      // the tokens.
      //
      // Reading a custom property's resolved value needs an indirection:
      // getComputedStyle(docEl).getPropertyValue('--color-accent') returns the raw,
      // *unresolved* `light-dark(#e5533d, #ff7a63)` text — custom properties are
      // untyped, so the browser never evaluates the function inside one the way it does
      // for an actual <color> property. Setting that raw text as an SVG fill or a
      // theme-color is simply invalid, silently. The fix is the standard one: apply the
      // custom property to a real `color` on a throwaway element and read `.color` back
      // off *that* — a typed property, so light-dark() (and var() generally) resolves.
      function resolveColor(varName: string): string {
        const probe = document.createElement('span');
        probe.style.cssText = `position:absolute;visibility:hidden;color:var(${varName})`;
        document.documentElement.appendChild(probe);
        const resolved = getComputedStyle(probe).color;
        probe.remove();
        return resolved;
      }
      const accent = resolveColor('--color-accent');
      const onAccent = resolveColor('--color-on-accent');
      if (accent && onAccent) {
        const svg =
          `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">` +
          `<path fill="${accent}" d="M16 3C8 7 5 14 6 24c0 2 1 4 3 5 9 0 16-6 18-14 1-4 0-8-2-12-3 0-6 0-9 0z"/>` +
          `<path fill="${onAccent}" d="M11 17h10v9H11zm2-4a3 3 0 0 1 6 0v4h-2v-4a1 1 0 0 0-2 0v4h-2z"/>` +
          `</svg>`;
        const favicon = document.getElementById('siteFavicon');
        if (favicon) favicon.setAttribute('href', 'data:image/svg+xml,' + encodeURIComponent(svg));
        const themeColor = document.getElementById('siteThemeColor');
        if (themeColor) themeColor.setAttribute('content', accent);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t.nav.skipToContent}</a>
    {/* Sticky as one unit, not just the sidebar offset by its measured height: the
        sidebar is `position: fixed; top: var(--tools-chrome-h)` (ToolsSidebar.astro),
        which is only correct while this chrome is actually still at the top of the
        viewport. Without this wrapper the header/strip scroll away normally, leaving a
        gap the height of --tools-chrome-h above the sidebar once they have — the
        sidebar held the reserved space open for chrome that was no longer there. */}
    <div class="site-chrome">
    <header class="site-header">
      <a href={getRelativeLocaleUrl(locale, '')} class="brand">
        {/* Inline, not <img src="/favicon.svg">: the browser tab icon can't react to a
            runtime skin/theme choice, but this mark is DOM we control, so it reads its
            colours from the same --color-accent/--color-on-accent tokens every skin
            already overrides — it re-skins for free, same as everything else. */}
        <svg class="brand__mark" viewBox="0 0 32 32" width="24" height="24" aria-hidden="true">
          <path fill="var(--color-accent)" d="M16 3C8 7 5 14 6 24c0 2 1 4 3 5 9 0 16-6 18-14 1-4 0-8-2-12-3 0-6 0-9 0z" />
          <path fill="var(--color-on-accent)" d="M11 17h10v9H11zm2-4a3 3 0 0 1 6 0v4h-2v-4a1 1 0 0 0-2 0v4h-2z" />
        </svg>
        {t.site.name}
      </a>
      <nav class="site-nav" aria-label={t.nav.label}>
        <ToolsMenu />
        <a class="nav-link" href={getRelativeLocaleUrl(locale, 'guides')}>{t.nav.guides}</a>
        <a class="nav-link" href={getRelativeLocaleUrl(locale, 'security')}>{t.nav.security}</a>
        <a class="nav-link" href={getRelativeLocaleUrl(locale, 'pricing')}>{t.nav.pricing}</a>
        <a class="nav-link" href={getRelativeLocaleUrl(locale, 'business')}>{t.nav.business}</a>
        <AuthNavLink
          client:only="react"
          loginLabel={t.nav.login}
          loginHref={getRelativeLocaleUrl(locale, 'login')}
          accountLabel={t.nav.dashboard}
          accountHref={getRelativeLocaleUrl(locale, 'dashboard')}
        />
      </nav>
      <LanguageSwitcher path={path} locale={locale} t={t.language} />
      <SkinPicker t={t.appearance} />
      <ThemeToggle t={t.theme} />
    </header>
    <p class="privacy-strip">{t.site.privacyNote}</p>
    <LanguageSuggestion path={path} locale={locale} />
    </div>
    {
      toolsSidebar && (
        // The fixed sidebar needs to start below the header and privacy strip, not
        // under them — otherwise its own title/search/dock controls render behind that
        // chrome at the top of the page (only revealed once the page is scrolled and
        // the non-fixed header scrolls away, which is backwards: those controls should
        // always be reachable). Header height isn't knowable at build time (it wraps
        // to two rows under ~48rem, and locale text length varies it further), so this
        // measures the real rendered height and exposes it as a CSS var the sidebar's
        // `top` reads — run here, inline, between the header and the sidebar in the
        // document so it executes (and triggers layout) before the sidebar first
        // paints, rather than after like a deferred script would.
        <script is:inline set:html={chromeHeightScript} />
      )
    }
    {
      toolsSidebar ? (
        <div class="tools-layout">
          <ToolsSidebar defaultHidden={toolsSidebarDefaultHidden} />
          <main id="content" class="tools-layout__main">
            <slot />
          </main>
        </div>
      ) : (
        <main id="content">
          <slot />
        </main>
      )
    }
    <SiteFooter withSidebar={Boolean(toolsSidebar)} />
    <script>
      // Offline and installable (public/sw.js, filled in by integrations/service-worker.mjs).
      // Deliberately not `is:inline`: Astro bundles this into a file of its own, which the
      // CSP already allows as 'self'. An inline script here would need a hash, and only the
      // theme script in <head> gets one — that one has to be inline to beat first paint.
      // Registered after load so it never competes with the page's own requests, and
      // skipped silently where service workers don't exist or are blocked.
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
    <script>
      // A light fade-and-rise as these sections enter view — the site had zero motion
      // beyond hover states, which read as static rather than calm. Deliberately not
      // is:inline: this can run after first paint with no first-paint cost, so it
      // doesn't need Astro.csp.insertScriptHash() the way Base.astro's two pre-paint
      // scripts do (see CLAUDE.md's CSP note for why that one is awkward to get right).
      //
      // Only elements already BELOW the viewport when this runs are ever hidden-then-
      // revealed — anything already on screen (a short page, a fast scroller, a tall
      // tool page's "Private by design" column) is left alone at its default opacity,
      // so there's no flash-of-hidden-content and no risk to LCP, which this runs well
      // after. `.tool-grid li` covers the home page's category grids, every tool page's
      // "Related tools", and the category hub grids — the same markup, all three
      // places — without per-page changes.
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const selector = '.tool-info > div, .faq > details, .card-list li, .tool-grid li, .category';
        const vh = innerHeight;
        const pending: Element[] = [];
        for (const el of document.querySelectorAll(selector)) {
          // The recent-work shelf re-renders client-side on its own schedule — not a
          // scroll-driven reveal's business, and its items would never settle into view.
          if (el.closest('.dashboard__quick')) continue;
          if (el.getBoundingClientRect().top > vh) {
            el.classList.add('reveal-pending');
            pending.push(el);
          }
        }
        if (pending.length) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.remove('reveal-pending');
                io.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
          );
          for (const el of pending) io.observe(el);
        }
      }
    </script>
    <script>
      // Shrinks the sticky header to just the brand mark once the page has scrolled a
      // little — on a phone, the full header permanently ate a real share of the
      // viewport, on every page, for chrome a visitor only actually needs at the very
      // top. The privacy strip ("Everything happens in your browser...") stays put
      // through this, on the owner's instruction — it's the one line worth keeping
      // visible the whole time someone's using a tool, not just at the top of the
      // page. Site-wide, not gated behind `toolsSidebar`: the crowding applies to
      // every page, sidebar or not.
      //
      // Two thresholds, not one, and far apart — this is sticky, so it still occupies
      // document flow space, and condensing it shrinks that space, shifting everything
      // below it upward. That shift moves whatever a visitor's cursor (or a test's
      // scroll-into-view) was aiming at, which can nudge scrollY back across a single
      // shared threshold and flip the state right back — condense, shift, re-cross,
      // expand, shift again, forever. Found this the hard way: a real e2e regression
      // where a result panel's Download link became permanently "not stable" to click,
      // because Playwright's own auto-scroll kept landing exactly on that boundary. A
      // wide dead zone between condense-at and expand-at means one shift from toggling
      // can never itself cross back over the other threshold.
      const chrome = document.querySelector('.site-chrome');
      if (chrome) {
        const CONDENSE_AT = 64;
        const EXPAND_AT = 16;
        let condensed = false;
        // Only pages with a sidebar read --tools-chrome-h, but setting it unconditionally
        // is simpler than branching on `toolsSidebar`, and costs nothing on pages without one.
        // Measured from the whole chrome box, not header plus strip, and measured again when
        // the header's padding transition ends and whenever the box resizes: reading it only
        // at the moment the class flips caught the header mid-transition, 8px too tall, and
        // left that much gap between the header and the sidebar for the rest of the scroll.
        const updateChromeHeight = () => {
          const h = Math.round(chrome.getBoundingClientRect().height);
          document.documentElement.style.setProperty('--tools-chrome-h', h + 'px');
        };
        chrome.addEventListener('transitionend', updateChromeHeight);
        if (typeof ResizeObserver !== 'undefined') new ResizeObserver(updateChromeHeight).observe(chrome);
        const onScroll = () => {
          const y = window.scrollY;
          const shouldCondense = condensed ? y > EXPAND_AT : y > CONDENSE_AT;
          if (shouldCondense === condensed) return;
          condensed = shouldCondense;
          chrome.classList.toggle('site-chrome--condensed', condensed);
          updateChromeHeight();
        };
        addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
