---
import '../styles/global.css';
import '../styles/skins.css';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import AuthNavLink from '../components/auth/AuthNavLink';
import SiteFooter from '../components/SiteFooter.astro';
import SkinPicker from '../components/SkinPicker.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ToolsMenu from '../components/ToolsMenu.astro';
import ToolsSidebar from '../components/ToolsSidebar.astro';
import { getMessages, locales } from '../i18n';
import { graph, organization, siteName, website } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Path of this page without the locale prefix, e.g. "merge-pdf". Empty for the home page. */
  path: string;
  /** Share image under /og/, without extension; defaults to the site-wide one. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Extra schema.org items for this page; Organization and WebSite are always included. */
  jsonLd?: Record<string, unknown>[];
  /** Keep the page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /**
   * Show the persistent, categorized tools sidebar (src/components/ToolsSidebar.astro)
   * beside the content. Opt-in rather than site-wide: a marketing or content page's job
   * is to convert or inform on one thing, and a 40-tool rail fighting for attention
   * works against that — tool pages and the category hubs are where a visitor is
   * already inside the product and benefits from jumping straight to another tool.
   */
  toolsSidebar?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = 'default',
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  toolsSidebar = false,
} = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const t = getMessages(locale).common;
const site = Astro.site!;
const canonical = getAbsoluteLocaleUrl(locale, path);
const image = new URL(`/og/${ogImage}.png`, site).href;
const structuredData = graph([organization(site), website(site, locale), ...jsonLd]);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        Object.keys(locales).map((code) => <link rel="alternate" hreflang={code} href={getAbsoluteLocaleUrl(code, path)} />)
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', path)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" id="siteFavicon" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#e5533d" id="siteThemeColor" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={structuredData} />
    <script is:inline>
      // Apply a saved light/dark choice before first paint, so the page doesn't flash.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        // Same reasoning, for the tools sidebar: apply a saved hidden choice and dock
        // edge before first paint so a returning visitor doesn't see it flash open, or
        // on the wrong edge, before settling. With nothing saved, a narrow viewport
        // still needs a pre-paint default: a first mobile visit should not flash a
        // full-screen overlay it never asked for, so this matches ToolsSidebar.astro's
        // own un-saved default of "hidden" below 48rem.
        const sidebarVisible = localStorage.getItem('toolsSidebarVisible');
        if (sidebarVisible === 'hidden' || sidebarVisible === 'visible') {
          document.documentElement.dataset.sidebarState = sidebarVisible;
        } else if (window.matchMedia('(max-width: 48rem)').matches) {
          document.documentElement.dataset.sidebarState = 'hidden';
        }
        // No dock-specific CSS exists for the attribute being absent, so a first-ever
        // visit (nothing stored yet) still needs an explicit default here, not just a
        // fallback in ToolsSidebar.astro's own script — otherwise the sidebar briefly
        // has no width or height at all, before that script runs.
        const sidebarDock = localStorage.getItem('toolsSidebarDock');
        document.documentElement.dataset.sidebarDock = sidebarDock === 'left' || sidebarDock === 'right' ? sidebarDock : 'left';
        // Same reasoning, for the chosen skin (src/components/SkinPicker.astro): a
        // cookie, not localStorage, so it's readable the same way whether or not the
        // visitor is signed in, and matches the site's existing leaflock_* cookie
        // convention (src/lib/server/session.ts). No cookie means the default skin —
        // already the :root tokens in global.css — so there's nothing to apply in that
        // case.
        const skinMatch = document.cookie.match(/(?:^|; )leaflock_skin=([^;]+)/);
        if (skinMatch) document.documentElement.dataset.skin = decodeURIComponent(skinMatch[1]);
      } catch {}
    </script>
    <script>
      // The favicon and the mobile theme-color meta both ship a static default (the
      // link/meta tags above) so there's something correct before this runs — then this
      // repaints both from whichever skin and light/dark mode are actually active. Same
      // leaf-and-lock shape as the header brand mark (below, in <body>): one more place
      // that would silently go stale if a colour were hard-coded instead of read from
      // the tokens.
      //
      // Reading a custom property's resolved value needs an indirection:
      // getComputedStyle(docEl).getPropertyValue('--color-accent') returns the raw,
      // *unresolved* `light-dark(#e5533d, #ff7a63)` text — custom properties are
      // untyped, so the browser never evaluates the function inside one the way it does
      // for an actual <color> property. Setting that raw text as an SVG fill or a
      // theme-color is simply invalid, silently. The fix is the standard one: apply the
      // custom property to a real `color` on a throwaway element and read `.color` back
      // off *that* — a typed property, so light-dark() (and var() generally) resolves.
      function resolveColor(varName: string): string {
        const probe = document.createElement('span');
        probe.style.cssText = `position:absolute;visibility:hidden;color:var(${varName})`;
        document.documentElement.appendChild(probe);
        const resolved = getComputedStyle(probe).color;
        probe.remove();
        return resolved;
      }
      const accent = resolveColor('--color-accent');
      const onAccent = resolveColor('--color-on-accent');
      if (accent && onAccent) {
        const svg =
          `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">` +
          `<path fill="${accent}" d="M16 3C8 7 5 14 6 24c0 2 1 4 3 5 9 0 16-6 18-14 1-4 0-8-2-12-3 0-6 0-9 0z"/>` +
          `<path fill="${onAccent}" d="M11 17h10v9H11zm2-4a3 3 0 0 1 6 0v4h-2v-4a1 1 0 0 0-2 0v4h-2z"/>` +
          `</svg>`;
        const favicon = document.getElementById('siteFavicon');
        if (favicon) favicon.setAttribute('href', 'data:image/svg+xml,' + encodeURIComponent(svg));
        const themeColor = document.getElementById('siteThemeColor');
        if (themeColor) themeColor.setAttribute('content', accent);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t.nav.skipToContent}</a>
    {/* Sticky as one unit, not just the sidebar offset by its measured height: the
        sidebar is `position: fixed; top: var(--tools-chrome-h)` (ToolsSidebar.astro),
        which is only correct while this chrome is actually still at the top of the
        viewport. Without this wrapper the header/strip scroll away normally, leaving a
        gap the height of --tools-chrome-h above the sidebar once they have — the
        sidebar held the reserved space open for chrome that was no longer there. */}
    <div class="site-chrome">
    <header class="site-header">
      <a href={getRelativeLocaleUrl(locale, '')} class="brand">
        {/* Inline, not <img src="/favicon.svg">: the browser tab icon can't react to a
            runtime skin/theme choice, but this mark is DOM we control, so it reads its
            colours from the same --color-accent/--color-on-accent tokens every skin
            already overrides — it re-skins for free, same as everything else. */}
        <svg class="brand__mark" viewBox="0 0 32 32" width="24" height="24" aria-hidden="true">
          <path fill="var(--color-accent)" d="M16 3C8 7 5 14 6 24c0 2 1 4 3 5 9 0 16-6 18-14 1-4 0-8-2-12-3 0-6 0-9 0z" />
          <path fill="var(--color-on-accent)" d="M11 17h10v9H11zm2-4a3 3 0 0 1 6 0v4h-2v-4a1 1 0 0 0-2 0v4h-2z" />
        </svg>
        {t.site.name}
      </a>
      <nav class="site-nav" aria-label={t.nav.label}>
        <ToolsMenu />
        <a class="nav-link" href={getRelativeLocaleUrl(locale, 'guides')}>{t.nav.guides}</a>
        <a class="nav-link" href={getRelativeLocaleUrl(locale, 'security')}>{t.nav.security}</a>
        <a class="nav-link" href={getRelativeLocaleUrl(locale, 'pricing')}>{t.nav.pricing}</a>
        <a class="nav-link" href={getRelativeLocaleUrl(locale, 'business')}>{t.nav.business}</a>
        <AuthNavLink
          client:only="react"
          loginLabel={t.nav.login}
          loginHref={getRelativeLocaleUrl(locale, 'login')}
          accountLabel={t.nav.dashboard}
          accountHref={getRelativeLocaleUrl(locale, 'dashboard')}
        />
      </nav>
      <SkinPicker t={t.appearance} />
      <ThemeToggle t={t.theme} />
    </header>
    <p class="privacy-strip">{t.site.privacyNote}</p>
    </div>
    {
      toolsSidebar && (
        // The fixed sidebar needs to start below the header and privacy strip, not
        // under them — otherwise its own title/search/dock controls render behind that
        // chrome at the top of the page (only revealed once the page is scrolled and
        // the non-fixed header scrolls away, which is backwards: those controls should
        // always be reachable). Header height isn't knowable at build time (it wraps
        // to two rows under ~48rem, and locale text length varies it further), so this
        // measures the real rendered height and exposes it as a CSS var the sidebar's
        // `top` reads — run here, inline, between the header and the sidebar in the
        // document so it executes (and triggers layout) before the sidebar first
        // paints, rather than after like a deferred script would.
        <script is:inline>
          (function () {
            var header = document.querySelector('.site-header');
            var strip = document.querySelector('.privacy-strip');
            var h = (header ? header.offsetHeight : 0) + (strip ? strip.offsetHeight : 0);
            document.documentElement.style.setProperty('--tools-chrome-h', h + 'px');
          })();
        </script>
      )
    }
    {
      toolsSidebar ? (
        <div class="tools-layout">
          <ToolsSidebar />
          <main id="content" class="tools-layout__main">
            <slot />
          </main>
        </div>
      ) : (
        <main id="content">
          <slot />
        </main>
      )
    }
    <SiteFooter />
    <script>
      // Offline and installable (public/sw.js, filled in by integrations/service-worker.mjs).
      // Deliberately not `is:inline`: Astro bundles this into a file of its own, which the
      // CSP already allows as 'self'. An inline script here would need a hash, and only the
      // theme script in <head> gets one — that one has to be inline to beat first paint.
      // Registered after load so it never competes with the page's own requests, and
      // skipped silently where service workers don't exist or are blocked.
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
