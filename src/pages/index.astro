---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../layouts/Base.astro';
import PrivacyDiagram from '../components/PrivacyDiagram.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { format, getMessages } from '../i18n';
import { itemList } from '../lib/seo';
import { categories, toolById, tools } from '../tools/registry';

const locale = Astro.currentLocale ?? 'en';
const messages = getMessages(locale);
const common = messages.common;
// The primary call to action points at the most-searched-for tool. Taken from the
// registry so it cannot drift from the published slug.
const mergeTool = toolById('merge');

// One readable list of everything the site does, for a crawler or an assistant asked
// what tools exist. Registry order, so it cannot fall behind the grid below.
const jsonLd = [
  itemList({
    name: common.site.allTools,
    items: tools.map((tool) => ({
      name: messages.tools[tool.id].title,
      url: getAbsoluteLocaleUrl(locale, tool.slug),
    })),
  }),
];
---

<Base
  title={`${common.site.name}: ${common.site.tagline}`}
  description={common.site.metaDescription}
  path=""
  jsonLd={jsonLd}
  toolsSidebar
  toolsSidebarDefaultHidden
>
  <section class="hero">
    <div class="hero__text">
      <p class="hero__eyebrow">{common.site.eyebrow}</p>
      <h1>{common.site.tagline}</h1>
      <p class="lead">{common.site.privacyNote}</p>
      <div class="hero__cta">
        <a class="primary-button" href={getRelativeLocaleUrl(locale, mergeTool.slug)}>
          {common.cta.merge}
        </a>
        <a class="secondary-button" href={getRelativeLocaleUrl(locale, 'security')}>
          {common.cta.howItWorks}
        </a>
      </div>
    </div>
    <PrivacyDiagram
      label={common.diagram.label}
      device={common.diagram.device}
      work={common.diagram.work}
      result={common.diagram.result}
      server={common.diagram.server}
    />
  </section>
  {/* Outside .hero__text, not inside it: that column is only ~half the page's width
      (shared with PrivacyDiagram), too narrow to fit all four claims on the one line
      they're meant to read as — full hero width has room to spare. Tool pages
      ([tool].astro) have no such column to escape; their hero is already full width. */}
  <ul class="trust">
    <li>{common.trust.noUpload}</li>
    <li>{common.trust.worksOffline}</li>
    <li>{common.trust.freeToStart}</li>
    <li>{common.trust.noFileSizeLimit}</li>
  </ul>

  {
    categories.map((category, index) => {
      const inCategory = tools.filter((tool) => tool.category === category);
      return (
        <details class={`category category--${category}${index === 0 ? ' category--first' : ''}`} open={index === 0}>
          <summary>
            <ToolIcon category={category} />
            <span class="category__name">{common.categories[category]}</span>
            <span class="category__count">{inCategory.length}</span>
            <span class="category__rule"></span>
            <svg class="category__chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 6 6 6-6 6" />
            </svg>
          </summary>
          <ul class="tool-grid">
            {inCategory.map((tool) => (
              <li>
                <a href={getRelativeLocaleUrl(locale, tool.slug)}>
                  <span class="tool-grid__icon">
                    <ToolIcon tool={tool.id} />
                  </span>
                  <strong>
                    {messages.tools[tool.id].title}
                    {tool.tier !== 'free' && <span class="badge-pro">{common.toolPage.tiers[tool.tier].label}</span>}
                  </strong>
                  <span>{messages.tools[tool.id].summary}</span>
                </a>
              </li>
            ))}
          </ul>
          {/* The category hub (src/pages/tools/[category].astro) is the real destination for
              browsing past the headline tools — this just says it exists, same link the <a>
              in the summary already points at (common.categories[category] itself is not a
              link anymore now that the whole summary is a native toggle control). */}
          <a class="category__viewAll" href={getRelativeLocaleUrl(locale, `tools/${category}`)}>
            {format(common.home.viewAll, { category: common.categories[category] })}
          </a>
        </details>
      );
    })
  }
</Base>
