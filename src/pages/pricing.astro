---
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import Article from '../layouts/Article.astro';
import '../styles/early-notice.css';
import '../styles/member-panel.css';
import CheckoutButton from '../components/billing/CheckoutButton';
import MemberPanel from '../components/billing/MemberPanel';
import { format, getMessages } from '../i18n';
import {
  formatEarlyAccessEnd,
  formatPlansStart,
  formatPrice,
  launchPercentOff,
  launchPrice,
  offerOpen,
  paidPlansAvailable,
  plansStartAt,
  prices,
  yearlySavingPercent,
} from '../lib/pricing';
import { product } from '../lib/seo';

const locale = Astro.currentLocale ?? 'en';
const messages = getMessages(locale);
const t = messages.pricing;
const price = (amount: number) => formatPrice(amount, locale);
// The launch offer (src/lib/pricing.ts): checkout is open and discounted while early access lasts.
const offer = offerOpen() && !paidPlansAvailable;
const buyable = paidPlansAvailable || offer;
const dates = { endDate: formatEarlyAccessEnd(locale), startDate: formatPlansStart(locale) };
const was = (amount: number) => format(t.offer.was, { price: price(amount) });
const plans = [
  {
    id: 'free',
    plan: t.plans.free,
    price: t.plans.free.price,
    period: '',
    note: '',
    href: getRelativeLocaleUrl(locale, ''),
    available: true,
    planKeys: undefined,
  },
  {
    id: 'pro',
    plan: t.plans.pro,
    price: price(prices.proMonthly),
    period: t.perMonth,
    note: offer
      ? `${price(launchPrice('proYearly'))} ${t.perYear} · ${was(prices.proYearly)}`
      : `${price(prices.proYearly)} ${t.perYear} · ${format(t.yearlySaving, { percent: yearlySavingPercent() })}`,
    href: undefined,
    available: buyable,
    // The yearly plan first: it is the one the launch offer discounts.
    planKeys: [
      { key: 'proYearly' as const, label: t.checkout.buyYearly },
      { key: 'proMonthly' as const, label: t.checkout.buyMonthly },
    ],
  },
  {
    id: 'lifetime',
    plan: t.plans.lifetime,
    price: price(offer ? launchPrice('proTenYear') : prices.proTenYear),
    period: t.oneTime,
    note: offer ? was(prices.proTenYear) : '',
    href: undefined,
    available: buyable,
    planKeys: [{ key: 'proTenYear' as const, label: t.checkout.buy }],
  },
  {
    id: 'practice',
    plan: t.plans.practice,
    price: price(offer ? launchPrice('practiceYearly') : prices.practiceYearly),
    period: t.perYear,
    note: offer ? was(prices.practiceYearly) : '',
    href: undefined,
    available: buyable,
    planKeys: [{ key: 'practiceYearly' as const, label: t.checkout.buy }],
  },
  {
    id: 'business',
    plan: t.plans.business,
    price: price(prices.businessYearly),
    period: t.perCompanyYear,
    note: '',
    href: getRelativeLocaleUrl(locale, 'business'),
    available: true,
    planKeys: undefined,
  },
];
// Offers only once there is a checkout behind them: markup for a plan nobody can buy
// would be a false claim, and that is exactly what `buyable` gates.
const jsonLd = buyable
  ? [
      product({
        name: `${messages.common.site.name} Pro`,
        description: t.metaDescription,
        url: getAbsoluteLocaleUrl(locale, 'pricing'),
        site: Astro.site!,
        offers: [
          { name: t.plans.pro.name, price: prices.proMonthly, recurring: 'month' as const },
          { name: t.plans.pro.name, price: offer ? launchPrice('proYearly') : prices.proYearly, recurring: 'year' as const },
          { name: t.plans.lifetime.name, price: offer ? launchPrice('proTenYear') : prices.proTenYear, recurring: null },
          {
            name: t.plans.practice.name,
            price: offer ? launchPrice('practiceYearly') : prices.practiceYearly,
            recurring: 'year' as const,
          },
        ],
      }),
    ]
  : [];

---

<Article title={t.title} description={t.metaDescription} path="pricing" extraJsonLd={jsonLd}>
  <p class="lead">{t.intro}</p>
  <MemberPanel
    client:only="react"
    t={t.member}
    names={{ pro: t.plans.pro.name, lifetime: t.plans.lifetime.name, practice: t.plans.practice.name, business: t.plans.business.name }}
    plansStartAt={plansStartAt}
    startDate={dates.startDate}
    endDate={dates.endDate}
    offerPrice={price(launchPrice('practiceYearly'))}
    standardPrice={price(prices.practiceYearly)}
    businessHref={getRelativeLocaleUrl(locale, 'business')}
  />
  {!paidPlansAvailable && <p class="notice for-new">{format(t.earlyAccess, dates)}</p>}
  {
    offer && (
      <p class="early-notice for-new">
        <strong>{format(t.offer.heading, { ...dates, percent: Math.max(...Object.values(launchPercentOff)) })}</strong>{' '}
        {format(t.offer.body, {
          ...dates,
          yearlyPercent: launchPercentOff.proYearly,
          tenYearPercent: launchPercentOff.proTenYear,
        })}
      </p>
    )
  }
  <div slot="after">
    <ul class="pricing-grid">
      {
        plans.map(({ id, plan, price, period, note, href, available, planKeys }) => (
          <li class={`pricing-card pricing-card--${id}${id === 'business' ? '' : ' for-new'}`}>
            <h2>{plan.name}</h2>
            <p class="pricing-card__price">
              <strong>{price}</strong> {period && <span class="muted">{period}</span>}
            </p>
            {note && <p class="muted">{note}</p>}
            <p>{plan.summary}</p>
            <ul class="pricing-card__features">
              {plan.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
            {available && planKeys ? (
              planKeys.map(({ key, label }) => <CheckoutButton client:only="react" plan={key} label={label} t={t.checkout} />)
            ) : available && href ? (
              <a class="primary-button" href={href}>
                {plan.cta}
              </a>
            ) : (
              <span class="secondary-button is-disabled" aria-disabled="true">
                {plan.cta}
              </span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="muted">{t.comingToPro}</p>
    <section class="promises">
      <h2>{t.promisesHeading}</h2>
      <ul>{t.promises.map((promise) => <li>{promise}</li>)}</ul>
    </section>
  </div>
</Article>
