---
import type { GetStaticPaths } from 'astro';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { getMessages } from '../../i18n';
import { breadcrumbs, itemList } from '../../lib/seo';
import { tierBadgeText } from '../../lib/tierBadge';
import { categories, tools, type ToolCategory } from '../../tools/registry';

/**
 * The category hub pages, e.g. /tools/organize — one per entry in `categories`.
 *
 * Why these didn't exist until now: the home page already shows every category as its
 * own section, so a category's tools were always reachable, but never at a URL of
 * their own. That meant no page to rank for "organize pdf tools", nothing for a guide
 * or comparison page to link a reader into besides the single tool it happened to
 * mention, and no breadcrumb middle step — the tool page's own breadcrumb already said
 * "All tools / Organize", with nothing behind "Organize" to click.
 *
 * Nested under /tools/ rather than at the top level deliberately: a category id
 * (`organize`, `edit`, `secure`…) sitting bare at the site root risks colliding with a
 * future tool or content-page slug, and "never change a published slug" (registry.ts)
 * means that has to be got right the first time, not fixed later.
 */
export const getStaticPaths = (() =>
  categories.map((category) => ({ params: { category }, props: { category } }))) satisfies GetStaticPaths;

const { category } = Astro.props as { category: ToolCategory };
const locale = Astro.currentLocale ?? 'en';
const messages = getMessages(locale);
const common = messages.common;
const label = common.categories[category];
const inCategory = tools.filter((tool) => tool.category === category);
const slug = `tools/${category}`;
const url = getAbsoluteLocaleUrl(locale, slug);

const jsonLd = [
  breadcrumbs([
    { name: common.site.name, url: getAbsoluteLocaleUrl(locale, '') },
    { name: label, url },
  ]),
  itemList({
    name: label,
    items: inCategory.map((tool) => ({
      name: messages.tools[tool.id].title,
      url: getAbsoluteLocaleUrl(locale, tool.slug),
    })),
  }),
];
---

<Base
  title={`${label} PDF tools: ${common.site.name}`}
  description={common.categoryHub.intro[category]}
  path={slug}
  jsonLd={jsonLd}
  toolsSidebar
>
  <nav class="breadcrumb" aria-label={common.nav.breadcrumb}>
    <a href={getRelativeLocaleUrl(locale, '')}>{common.site.allTools}</a>
    <span aria-hidden="true">/</span>
    <span>{label}</span>
  </nav>
  <h1>
    <ToolIcon category={category} />
    {label}
  </h1>
  <p class="lead">{common.categoryHub.intro[category]}</p>

  <ul class="tool-grid">
    {
      inCategory.map((tool) => (
        <li>
          <a href={getRelativeLocaleUrl(locale, tool.slug)}>
            <span class="tool-grid__icon">
              <ToolIcon tool={tool.id} />
            </span>
            <strong>
              {messages.tools[tool.id].title}
              {tool.tier !== 'free' && <span class="badge-pro">{tierBadgeText(common.toolPage.tiers[tool.tier].label, messages.pricing.freeNow)}</span>}
            </strong>
            <span>{messages.tools[tool.id].summary}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
