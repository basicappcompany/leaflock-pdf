---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getMessages } from '../i18n';
import { categories, tools } from '../tools/registry';

const locale = Astro.currentLocale ?? 'en';
const messages = getMessages(locale);
const common = messages.common;
---

<details class="tools-menu">
  <summary>{common.nav.allTools}</summary>
  <div class="tools-menu__panel">
    {
      categories.map((category) => (
        <div class="tools-menu__group">
          <p class="tools-menu__heading">{common.categories[category]}</p>
          <ul>
            {tools
              .filter((tool) => tool.category === category)
              .map((tool) => (
                <li>
                  <a href={getRelativeLocaleUrl(locale, tool.slug)}>{messages.tools[tool.id].title}</a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </div>
</details>

<script>
  // Close the menu on Escape or a click outside it; it opens and closes natively otherwise.
  const menu = document.querySelector<HTMLDetailsElement>('.tools-menu');
  if (menu) {
    // On a phone the list opens inside the Menu, which scrolls on its own: bring the list to the top of it, so
    // pressing "All tools" shows tools rather than leaving them below the fold.
    menu.addEventListener('toggle', () => {
      const header = menu.closest<HTMLElement>('.site-header');
      if (!menu.open || !header || header.scrollHeight <= header.clientHeight) return;
      const offset = menu.getBoundingClientRect().top - header.getBoundingClientRect().top - 8;
      header.scrollTo({ top: header.scrollTop + offset, behavior: 'smooth' });
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
