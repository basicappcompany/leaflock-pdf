---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { format, getMessages } from '../i18n';
import { footerGroups } from '../lib/siteLinks';
import { categories, tools } from '../tools/registry';

interface Props {
  /** The page has the fixed tools sidebar, so the footer reserves the same room beside it. */
  withSidebar?: boolean;
}

const { withSidebar = false } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const messages = getMessages(locale);
const common = messages.common;
---

<footer class:list={['site-footer', { 'site-footer--with-sidebar': withSidebar }]}>
  {/* Two separate grids, not one flowing list: with all seven groups (four tool
      categories plus product/company/legal) in a single auto-fill grid, the categories
      filled exactly five columns at common widths and the three link groups wrapped
      into a short, ragged second row under only the first two of them — ragged because
      nothing ties where a group lands to what's semantically next to it. Splitting
      "tools" from "site" gives each its own row that wraps on its own terms. */}
  <div class="site-footer__columns">
    {
      categories.map((category) => (
        <nav class="site-footer__group" aria-label={common.categories[category]}>
          <p class="site-footer__heading">{common.categories[category]}</p>
          <ul>
            {tools
              .filter((tool) => tool.category === category)
              .map((tool) => (
                <li>
                  <a href={getRelativeLocaleUrl(locale, tool.slug)}>{messages.tools[tool.id].title}</a>
                </li>
              ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="site-footer__columns site-footer__columns--meta">
    {
      footerGroups.map((group) => (
        <nav class="site-footer__group" aria-label={common.footer[group.heading]}>
          <p class="site-footer__heading">{common.footer[group.heading]}</p>
          <ul>
            {group.pages.map((page) => (
              <li>
                <a href={getRelativeLocaleUrl(locale, page.path)}>{common.pageLinks[page.key]}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="site-footer__bottom">
    <p>{common.site.footer}</p>
    <p>{format(common.footer.copyright, { year: new Date().getFullYear() })}</p>
  </div>
</footer>
