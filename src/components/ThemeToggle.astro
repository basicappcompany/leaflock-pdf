---
import type { CommonMessages } from '../i18n';

interface Props {
  t: CommonMessages['theme'];
}

const { t } = Astro.props;
const options = [
  { value: 'system', label: t.system, icon: '◐' },
  { value: 'light', label: t.light, icon: '☀' },
  { value: 'dark', label: t.dark, icon: '☾' },
];
---

<fieldset class="theme-toggle">
  <legend class="visually-hidden">{t.label}</legend>
  {
    options.map((option) => (
      <label class="theme-toggle__option" title={option.label}>
        <input type="radio" name="theme" value={option.value} />
        <span aria-hidden="true">{option.icon}</span>
        <span class="visually-hidden">{option.label}</span>
      </label>
    ))
  }
</fieldset>

<script>
  // The saved choice is applied before first paint by the inline script in Base.astro;
  // this just keeps the radio buttons and storage in sync. Default is Light, not
  // System — nothing stored reads the same as an explicit 'light' choice, matching
  // what Base.astro's pre-paint script actually applies. 'system' is now stored
  // explicitly rather than represented by an absent key, since an absent key means
  // Light here, not "follow the OS".
  const stored = localStorage.getItem('theme');
  const current = stored === 'dark' || stored === 'system' ? stored : 'light';
  for (const input of document.querySelectorAll<HTMLInputElement>('.theme-toggle input[name="theme"]')) {
    input.checked = input.value === current;
    input.addEventListener('change', () => {
      localStorage.setItem('theme', input.value);
      if (input.value === 'system') delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = input.value;
    });
  }
</script>
