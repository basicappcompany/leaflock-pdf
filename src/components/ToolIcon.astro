---
import { categoryIcons, toolIcons } from '../lib/icons';
import type { ToolCategory, ToolId } from '../tools/registry';

interface Props {
  /** A tool's icon, or a category's. */
  tool?: ToolId;
  category?: ToolCategory;
  class?: string;
}

const { tool, category, class: className = 'tool-icon' } = Astro.props;
const markup = tool ? toolIcons[tool] : category ? categoryIcons[category] : '';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={markup}
/>
