---
/**
 * Shows the whole product in one picture: the file goes into the browser, the work
 * happens there, the result comes back out — and the server is never in the path.
 *
 * Drawn with the theme's own variables so it works in light and dark without a second
 * copy, and marked up as an image with a label so it reads as one thing to a screen
 * reader rather than a pile of shapes.
 */
interface Props {
  label: string;
  device: string;
  work: string;
  result: string;
  server: string;
}

const { label, device, work, result, server } = Astro.props;
---

<svg class="privacy-diagram" viewBox="0 0 440 150" role="img" aria-label={label}>
  <!-- Your device. The frame has to enclose the result as well as the file and the
       browser: the point of the picture is that the finished file never leaves either. -->
  <rect class="privacy-diagram__frame" x="8" y="26" width="318" height="96" rx="10" />
  <text class="privacy-diagram__caption" x="20" y="18">{device}</text>

  <g class="privacy-diagram__ink">
    <path d="M44 56h22l10 10v30a3 3 0 0 1-3 3H44a3 3 0 0 1-3-3V59a3 3 0 0 1 3-3Z" />
    <path d="M66 56v10h10" />
  </g>

  <path class="privacy-diagram__arrow" d="M92 74h26m0 0-6-6m6 6-6 6" />

  <g class="privacy-diagram__ink">
    <rect x="130" y="48" width="96" height="56" rx="6" />
    <path d="M130 62h96" />
    <circle cx="140" cy="55" r="2.5" />
    <circle cx="149" cy="55" r="2.5" />
  </g>
  <text class="privacy-diagram__label" x="178" y="88">{work}</text>

  <path class="privacy-diagram__arrow" d="M238 74h26m0 0-6-6m6 6-6 6" />

  <g class="privacy-diagram__ink">
    <path d="M276 56h22l10 10v30a3 3 0 0 1-3 3h-29a3 3 0 0 1-3-3V59a3 3 0 0 1 3-3Z" />
    <path d="M298 56v10h10" />
    <path class="privacy-diagram__tick" d="m281 84 5 5 10-10" />
  </g>
  <text class="privacy-diagram__label" x="291" y="116">{result}</text>

  <!-- The server, struck through and outside the frame: nothing ever goes this way. -->
  <g class="privacy-diagram__never">
    <rect x="352" y="52" width="68" height="44" rx="6" />
    <path d="M352 74h68" />
    <path d="M363 63h6M363 85h6" />
    <path d="m346 46 80 56" />
  </g>
  <text class="privacy-diagram__caption privacy-diagram__caption--never" x="386" y="118">{server}</text>
</svg>
