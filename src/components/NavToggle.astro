---
/**
 * The phone-width Menu button (an icon, with its name for screen readers). Under 48rem the header's links (All tools, Guides, Security, Pricing, Business, Log in)
 * sit in one panel this button opens, instead of wrapping across the header on every page. Above that width the button
 * is hidden and the links show inline as before. The panel is `#site-nav`, set in Base.astro.
 *
 * Without script the button never shows and the links stay visible (the CSS only hides them when scripting is on), so
 * a visitor with JavaScript off loses nothing.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav">
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M4 7h16M4 12h16M4 17h16"></path>
  </svg>
  <span class="visually-hidden">{label}</span>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle('site-nav--open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('site-nav--open')));
    // A tap anywhere outside the menu closes it. The panel and the Menu button count as inside; a link inside the panel
    // navigates away on its own.
    document.addEventListener('click', (event) => {
      if (!nav.classList.contains('site-nav--open')) return;
      const target = event.target as Node;
      if (nav.contains(target) || toggle.contains(target)) return;
      setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('site-nav--open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    // Widening the window past the phone layout must not leave a stale open state behind.
    window.matchMedia('(min-width: 48.01rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
