---
import { getEntry, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import type { contentPages } from '../../lib/siteLinks';

interface Props {
  page: (typeof contentPages)[number];
}

const { page } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const entry = (await getEntry('pages', `${locale}/${page}`)) ?? (await getEntry('pages', `en/${page}`));
if (!entry) throw new Error(`Missing content page: src/content/pages/${locale}/${page}.md`);
const { Content } = await render(entry);
---

<Article
  title={entry.data.title}
  description={entry.data.description}
  path={page}
  updated={entry.data.updated}
  awaitingLegalReview={entry.data.awaitingLegalReview}
>
  <Content />
</Article>
