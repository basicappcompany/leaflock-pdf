# Cloudflare Pages response headers. The main Content-Security-Policy is a <meta> tag
# generated by Astro (see astro.config.mjs); these cover what a <meta> tag cannot.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# The worker is how every other asset gets updated, so it must never come from a cache
# itself — a stale sw.js would pin a visitor to an old build indefinitely.
/sw.js
  Cache-Control: no-cache
  Content-Type: text/javascript; charset=utf-8
